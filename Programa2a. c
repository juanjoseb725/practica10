#include <stdio.h>

int main()
{
    int i, j, a[5][5];

    // Recorremos los renglones
    for (i = 0; i < 5; i++)
    {
        // Recorremos las columnas
        for (j = 0; j < 5; j++)
        {
            // El valor de la posición es la suma de sus índices
            a[i][j] = i + j;
            printf("\t%d, ", a[i][j]);
        }
        // Salto de línea después de cada fila para que se vea como matriz
        printf("\n");
    }

    return 0;
}
